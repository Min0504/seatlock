# PostgreSQL (docker-compose.dev.yml 기준)
DATABASE_URL="postgresql://seatlock:seatlock@localhost:55432/seatlock?schema=public"

# JWT — 운영에서는 반드시 32바이트 이상 무작위 값 사용. TTL은 초 단위
JWT_ACCESS_SECRET="change-me-access-secret-32bytes-min!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-32bytes-min!"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=1209600

# Redis (docker-compose.dev.yml 기준)
REDIS_URL="redis://localhost:63790"

PORT=3000
